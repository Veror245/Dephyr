# ==============================================================================
# Dephyr Backend Environment Variables
# Copy this file to .env:  cp .env.example .env
# ==============================================================================

# Authentication & Security
ALLOW_UNAUTHENTICATED=true 
GITHUB_ALLOWED_REPOS=dephyr-demo/repo-c,dephyr-demo/gateway-proxy,dephyr-demo/repo-a,veror245/researchforge

# GitHub Integration
GITHUB_TOKEN=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
GITHUB_API=https://api.github.com

# National Vulnerability Database (NVD)
NVD_API_KEY=

# Rust Static Analysis Engine
RUST_URL=http://127.0.0.1:3000
RUST_MOCK=false

# Storage & Paths
WORKSPACE=./workspace
DB_PATH=./dephyr.sqlite3

# Concurrency Limits
MAX_ACTIVE_SCANS=3
MAX_ACTIVE_GIT_JOBS=2

# Frontend CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

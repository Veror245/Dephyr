# ==============================================================================
# Dephyr Backend Environment Variables Template
# ==============================================================================

# Authentication
# Set to 'true' to allow unauthenticated requests (ideal for local development).
# Set to 'false' to enforce 'X-API-Key' validation against API_KEY.
ALLOW_UNAUTHENTICATED=true
API_KEY=

# GitHub Integration
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=dephyr-demo/repo-c,dephyr-demo/gateway-proxy,dephyr-demo/repo-a,*
GITHUB_API=https://api.github.com

# NVD API Key (optional, for CVE rate limit bypass)
NVD_API_KEY=

# Rust Static Analysis Engine
RUST_URL=http://127.0.0.1:3000/scan
RUST_MOCK=false

# Concurrency & Workspaces
WORKSPACE=./workspace
DB_PATH=./dephyr.sqlite3
MAX_ACTIVE_SCANS=3
MAX_ACTIVE_GIT_JOBS=2

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

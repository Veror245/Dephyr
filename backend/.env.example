# ==============================================================================
# Dephyr Backend Environment Variables
# Copy this file to .env:  cp .env.example .env
# ==============================================================================

# Authentication & Security
API_KEY=
ALLOW_UNAUTHENTICATED=true
GITHUB_ALLOWED_REPOS=dephyr-demo/repo-c,dephyr-demo/gateway-proxy,dephyr-demo/repo-a,veror245/researchforge

# GitHub Integration
GITHUB_TOKEN=
GITHUB_API=https://api.github.com

# National Vulnerability Database (NVD)
NVD_API_KEY=

# Rust Static Analysis Engine
RUST_URL=http://127.0.0.1:4000
RUST_MOCK=true

# Storage & Paths
DEPHYR_WORKSPACE=./workspace
DATABASE_PATH=./dephyr.sqlite3

# Concurrency Limits
MAX_ACTIVE_SCANS=3
MAX_ACTIVE_GIT_JOBS=2

# Frontend CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
